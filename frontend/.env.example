# Copy to .env.local. Only VITE_* values are bundled into the browser build, so NEVER put secrets here.
# Base URL of the SecureAI Gateway API (including /api/v1). Must be listed in the backend's CORS_ORIGINS
# from the browser's perspective (i.e. the *frontend* origin must be listed, not this URL).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
