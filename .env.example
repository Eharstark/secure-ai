# Copy to .env and adjust. NEVER commit the real .env file.

# development | testing | production
ENVIRONMENT=development

# Interactive docs (/docs, /redoc, /openapi.json).
# Always disabled when ENVIRONMENT=production, regardless of this value.
ENABLE_DOCS=true

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated explicit origins. Wildcard "*" is rejected.
# In production every origin must use https://
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLAlchemy URL. Relative SQLite path resolves from the directory you start the app in
# (backend/ for local runs). Docker Compose overrides this to a persistent volume path.
DATABASE_URL=sqlite:///./data/secureai.db
