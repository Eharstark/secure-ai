# Copy to .env and adjust. NEVER commit the real .env file.

# development | testing | production
ENVIRONMENT=development

# Interactive docs (/docs, /redoc, /openapi.json).
# Always disabled when ENVIRONMENT=production, regardless of this value.
ENABLE_DOCS=true

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated explicit origins. Wildcard "*" is rejected.
# In production every origin must use https://
# 5173 = Vite dev server (npm run dev), 4173 = Vite preview (npm run preview), 3000 = other local tooling.
# Use the exact origin shown in the browser address bar: localhost and 127.0.0.1 are different origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000

# SQLAlchemy URL. Relative SQLite path resolves from the directory you start the app in
# (backend/ for local runs). Docker Compose overrides this to a persistent volume path.
DATABASE_URL=sqlite:///./data/secureai.db

# ---- Authentication (Milestone 2) ----
# REQUIRED. The app refuses to start without it. Generate a unique value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Minimum length: 32 chars (HS256), 48 (HS384), 64 (HS512). Never share or commit it.
JWT_SECRET_KEY=

# HS256 | HS384 | HS512
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (1-1440)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Value of the "iss" claim; tokens from other issuers are rejected
JWT_ISSUER=secureai-gateway
